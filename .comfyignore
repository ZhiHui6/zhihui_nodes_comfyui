# ─── 版本控制 / 元文件 ───
.git/
.gitignore
.comfyignore

# ─── Python 缓存与构建产物 ───
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
node.zip
*.bat

# ─── 编辑器 / IDE / 本地工具 ───
.vscode/
.idea/
.qoder/
.workbuddy-ai/

# ─── 本地调试文件（防止重建时被打包）───
doc/
tools/
test_*.html
test_*.cjs
workflow/

# ─── 媒体资源：README 配图不入包，仅随仓库分发 ───
images/
*.jpg
*.jpeg
*.gif
*.webp
*.mp4
*.mp3
*.wav
*.png
!icon.png

# ─── 敏感信息 ───
config/api_keys.json
Nodes/ImageUnderstandingOnline/api_config.json

# ─── 本地运行态：批处理最近文件夹与断点进度 ───
Nodes/ImageUnderstandingOnline/batch_config.json
